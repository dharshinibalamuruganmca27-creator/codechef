# cook your dish here
import sys

def solve():
    # Read the number of test cases
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    T = int(input_data[0])
    pointer = 1
    
    for _ in range(T):
        # N = number of rows, M = number of seats per row
        N = int(input_data[pointer])
        M = int(input_data[pointer + 1])
        pointer += 2
        
        # Calculate max usable rows (1, 3, 5...)
        usable_rows = (N + 1) // 2
        
        # Calculate max usable seats per row (1, 3, 5...)
        usable_seats = (M + 1) // 2
        
        # Total tickets = rows * seats
        print(usable_rows * usable_seats)

if __name__ == "__main__":
    solve()
