# cook your dish here
import sys

def solve():
    # Read all input at once for faster I/O
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    T = int(input_data[0])
    idx = 1
    results = []
    
    for _ in range(T):
        N = int(input_data[idx])
        X = int(input_data[idx+1])
        Y = int(input_data[idx+2])
        idx += 3
        
        # 1. Horizontal and Vertical moves
        ans = 2 * (N - 1)
        
        # 2. Diagonal moves (distance to each of the 4 corners)
        ans += min(X - 1, Y - 1)          # Top-Left
        ans += min(X - 1, N - Y)          # Top-Right
        ans += min(N - X, Y - 1)          # Bottom-Left
        ans += min(N - X, N - Y)          # Bottom-Right
        
        results.append(str(ans))
    
    # Print all results separated by a newline
    sys.stdout.write("\n".join(results) + "\n")

if __name__ == "__main__":
    solve()
